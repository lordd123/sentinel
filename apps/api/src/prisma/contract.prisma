model Event {
  id        String   @id @default(uuid())
  type      String
  source    String
  severity  String
  createdAt DateTime @default(now())
}

model Alert {
  id        String   @id @default(uuid())
  eventId   String
  rule      String
  severity  String
  reason    String
  createdAt DateTime @default(now())
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String
  createdAt    DateTime @default(now())
}